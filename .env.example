# Copy to .env and edit. Never commit .env.

# Required in production. Comma-separated; generate each with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
FINARENA_API_KEYS=change-me

# Build options (docker compose reads these for the image build)
# Base image (fast sentiment + credit):   EXTRAS=            PRELOAD_LLM=0
# With the LoRA LLM (about 3.8 GB):       EXTRAS=[llm]       PRELOAD_LLM=1
EXTRAS=
PRELOAD_LLM=0

# With the LLM image, refuse to start rather than silently serve only the fast model
# FINARENA_REQUIRE_LLM=1

# Requests per minute per client on /v1/* (0 disables). Per process: enforce at the gateway too if you run replicas.
FINARENA_RATE_PER_MINUTE=120

# Compose options: published port, image tag (for rollback) and the container memory cap (the LLM image needs about 3 GB)
# PORT=8000
# IMAGE_TAG=latest
# MEM_LIMIT=4g

# Behind a reverse proxy, trust its forwarded client IP (otherwise every client looks like the proxy):
# FORWARDED_ALLOW_IPS=10.0.0.5
